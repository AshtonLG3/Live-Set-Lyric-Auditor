HOST=0.0.0.0
PORT=4242
DEV_ALLOWED_HOSTS=.replit.dev,.picard.replit.dev

# Musixmatch: track identity, lyrics, subtitles, and RichSync
MUSIXMATCH_API_KEY=
MUSIXMATCH_API_BASE_URL=https://api.musixmatch.com/ws/1.1
MUSIXMATCH_TIMEOUT_MS=12000

# Audio ID: optional audio fingerprinting before ASR lyric rescue.
# Use acrcloud for a public fingerprint provider, or custom/musixmatch for a partner endpoint
# that returns title/artist/ISRC metadata from an uploaded clip.
AUDIO_ID_PROVIDER=
AUDIO_ID_FILE_FIELD=clip
AUDIO_ID_TIMEOUT_MS=12000
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
AUDIO_ID_API_URL=
AUDIO_ID_API_KEY=
MUSIXMATCH_AUDIO_ID_API_URL=
MUSIXMATCH_AUDIO_ID_API_KEY=

# JamBase: event, venue, lineup, and setlist context
JAMBASE_API_KEY=
JAMBASE_API_BASE_URL=https://api.data.jambase.com/v3

# Cyanite: performance energy, mood, BPM, and arrangement analysis
CYANITE_API_TOKEN=
CYANITE_API_BASE_URL=https://api.cyanite.ai/graphql
CYANITE_WEBHOOK_URL=https://your-domain.com/cyanite-webhook
CYANITE_REQUEST_TIMEOUT_MS=12000

# LALAL.AI: faster vocal split rescue when original-audio ASR/alignment is weak.
LALAL_LICENSE_KEY=
LALAL_API_BASE_URL=https://www.lalal.ai/api/v1
LALAL_POLL_INTERVAL_MS=3000
LALAL_POLL_TIMEOUT_MS=180000
LALAL_LEAD_BACK_ENABLED=true
LALAL_DEREVERB_ENABLED=true
LALAL_EXTRACTION_LEVEL=clear_cut
LALAL_ENCODER_FORMAT=mp3
LALAL_SPLITTER=

# Replicate Demucs: slow quality fallback after original ASR and LALAL rescue.
REPLICATE_DEMUCS_REF=cjwbw/demucs:25a173108cff36ef9f80f854c162d01df9e6528be175794b81158fa03836d953
# Demucs model: blank = htdemucs (fast). htdemucs_ft = fine-tuned 4-model ensemble,
# ~4x slower but markedly better vocal separation — recommended for confidence quality.
REPLICATE_DEMUCS_MODEL=htdemucs_ft
REPLICATE_DEMUCS_STEM=vocals

# ElevenLabs: optional narration audio and explicit Scribe retranscription
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_TIMEOUT_MS=60000

# External Whisper-compatible speech-to-text service
REPLICATE_API_TOKEN=
REPLICATE_WHISPER_VERSION=vaibhavs10/incredibly-fast-whisper:3ab86df6c8f54c11309d4d1f930ac292bad43ace52d10c80d87eb258b3c9f79c
REPLICATE_WHISPER_FALLBACK_VERSION=openai/whisper
ASR_COMPARE_ALL_MODELS=false
ASR_SLOW_FALLBACK_ENABLED=false
ASR_REPLICATE_TIMEOUT_MS=45000
FFMPEG_LOCATION=
CYANITE_POLL_INTERVAL_MS=2500
CYANITE_POLL_TIMEOUT_MS=20000
ASR_API_URL=
ASR_API_KEY=
